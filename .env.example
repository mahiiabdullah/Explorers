# All values shown here are the dev defaults used by docker-compose.yml.
# Override these by exporting env vars before `docker compose up`.

# ---------- Database ----------
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=cinema

# ---------- Backend ----------
JWT_SECRET=mysecretkey
ACCESS_TOKEN_SECRET=accesssecret
REFRESH_TOKEN_SECRET=refreshsecret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---------- Payment gateway ----------
GATEWAY_SECRET=z2p-2026-secret

# ---------- Poridhi load balancer (public URLs) ----------
# These are baked into the backend CORS allowlist and (via build args) into
# the Next.js bundle. Update these before `docker compose build` if the LB
# URLs change.
FRONTEND_URL=https://6a0b1d00950c78444441b4fb_0f8ad04d.lib.poridhi.io
# NOTE: BACKEND_URL stays as the in-network address. The webhook callbackUrl
# is POSTed by the gateway FROM INSIDE Docker → it must resolve via Docker DNS,
# not via the public LB (which is unreachable from the container).
BACKEND_URL=http://backend:5000
NEXT_PUBLIC_API_URL=https://6a0b1d00950c78444441b4fb_ba1b8620.lib.poridhi.io
NEXT_PUBLIC_SOCKET_URL=https://6a0b1d00950c78444441b4fb_ba1b8620.lib.poridhi.io
NEXT_PUBLIC_APP_URL=https://6a0b1d00950c78444441b4fb_0f8ad04d.lib.poridhi.io
GATEWAY_PUBLIC_URL=https://6a0b1d00950c78444441b4fb_89094519.lib.poridhi.io
